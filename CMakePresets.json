{
    "version": 8,
    "configurePresets": [
        {
            "name": "Visual Studio Community 2026 Release - amd64",
            "displayName": "Visual Studio Community 2026 Release - amd64",
            "description": "Using compilers for Visual Studio 18 2026 (x64 architecture)",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "clangd",
            "displayName": "clangd compile database (Ninja, configure only)",
            "description": "Generates compile_commands.json for clangd. Run from a Visual Studio developer environment.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/clangd",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Visual Studio Community 2026 Release - amd64-debug",
            "displayName": "Visual Studio Community 2026 Release - amd64 - Debug",
            "configurePreset": "Visual Studio Community 2026 Release - amd64",
            "configuration": "Debug"
        }
    ]
}