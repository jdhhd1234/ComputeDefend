{
    "version": 8,
    "configurePresets": [
        {
            "name": "Visual Studio Community 2026 Release - amd64",
            "displayName": "Visual Studio Community 2026 Release - amd64",
            "description": "Using compilers for Visual Studio 18 2026 (x64 architecture)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "mingw-x64-debug",
            "displayName": "MinGW-w64 x64 - Debug",
            "description": "Cross-compile for Windows using x86_64-w64-mingw32 GCC",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "mingw-x64-release",
            "displayName": "MinGW-w64 x64 - Release",
            "inherits": "mingw-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Visual Studio Community 2026 Release - amd64-debug",
            "displayName": "Visual Studio Community 2026 Release - amd64 - Debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "Visual Studio Community 2026 Release - amd64",
            "configuration": "Debug"
        },
        {
            "name": "mingw-x64-debug",
            "configurePreset": "mingw-x64-debug"
        },
        {
            "name": "mingw-x64-release",
            "configurePreset": "mingw-x64-release"
        }
    ]
}
