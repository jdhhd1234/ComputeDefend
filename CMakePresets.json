{
    "version": 8,
    "configurePresets": [
        {
            "name": "ninja-base",
            "hidden": true,
            "displayName": "Ninja + MSVC (x64)",
            "description": "Ninja generator with MSVC cl.exe. CMake Tools activates the VS developer environment (strategy: external).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug (x64)",
            "inherits": "ninja-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja Release (x64)",
            "inherits": "ninja-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "ninja-debug", "displayName": "Ninja Debug (x64)", "configurePreset": "ninja-debug" },
        { "name": "ninja-release", "displayName": "Ninja Release (x64)", "configurePreset": "ninja-release" }
    ]
}
