{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: ComputerDefender (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            // 사용자 환경변수(Vercel 주소)를 덮어써서 로컬 서버로 보낸다.
            "environment": [
                { "name": "COMPUTER_DEFENDER_URL", "value": "http://127.0.0.1:8000" }
            ],
            "preLaunchTask": "CMake: build"
        },
        {
            // 로컬 서버: API_KEY를 안 주면 인증 없이 열린다. 브라우저는 http://127.0.0.1:8000
            "name": "Python: FastAPI 서버 (로컬)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["src.Web.BackEnd.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        }
    ],
    "compounds": [
        {
            // F5 한 번으로 서버와 C++ 클라이언트를 같이 띄운다.
            "name": "로컬 전체 실행 (서버 + C++)",
            "configurations": ["Python: FastAPI 서버 (로컬)", "C++: ComputerDefender (Debug)"]
        }
    ]
}
